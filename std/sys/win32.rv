/* ==========================================================================
   MACRO HELPERS
   ========================================================================== */

MAKEWORD :: fn(a: BYTE, b: BYTE) -> WORD #inline {
	return cast(WORD, a) | (cast(WORD, b) << 8);
}

MAKELONG :: fn(a: WORD, b: WORD) -> DWORD #inline {
	return cast(DWORD, a) | (cast(DWORD, b) << 16);
}

LOWORD :: fn(l: DWORD_PTR) -> WORD #inline {
	return cast(WORD, l & 0xFFFF);
}

HIWORD :: fn(l: DWORD_PTR) -> WORD #inline {
	return cast(WORD, (l >> 16) & 0xFFFF);
}

GET_X_LPARAM :: fn(lp: LPARAM) -> i32 #inline {
	return cast(i32, cast(i16, cast(WORD, lp & 0xFFFF)));
}

GET_Y_LPARAM :: fn(lp: LPARAM) -> i32 #inline {
	return cast(i32, cast(i16, cast(WORD, (lp >> 16) & 0xFFFF)));
}

GET_WHEEL_DELTA_WPARAM :: fn(wp: WPARAM) -> i32 #inline {
	return cast(i32, cast(i16, cast(WORD, (wp >> 16) & 0xFFFF)));
}

