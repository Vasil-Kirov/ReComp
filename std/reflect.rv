module reflect

#import misc;

get_struct_members :: fn(t: type) -> []StructMember {
	ti := type_info t;
	if ti.kind != .Struct
		return .{};
	return ti.t.struct_.members;
}

get_register_bit_count :: fn() -> int {
	return size_of(*void) * 8;
}

get_struct_alignment :: fn(st: type) -> int {
	ti := type_info(st);
	#assert ti.kind == .Struct;
    t := ti.t.struct_;
    if t.members.count == 0
        return 1;

	if t.flags & .Packed != 0
		return 1;
    
    align := 1;
    for m in t.members {
        mem_align := get_type_alignment(m.t);
        if mem_align > align {
            align = mem_align;
        }
    }

    return align;
}

get_type_alignment :: fn(t: type) -> int {
    ti := type_info(t);
	ptr_size := get_register_bit_count() / 8;
    result := switch ti.kind {
        case .Basic: {
            if t == string
                yield ptr_size;
            yield get_basic_type_size(ti.t.basic);
        }
        case .Function: {
            yield ptr_size;
        }
        case .Pointer: {
            yield ptr_size;
        }
        case .Slice: {
            yield ptr_size;
        }
        case .Array: {
            yield get_type_alignment(ti.t.array.t);
        }
        case .Enum: {
            yield get_type_alignment(ti.t.enum_.t);
        }
        case .Struct: {
            yield get_struct_alignment(t);
        }
        case .Vector: {
            yield cast(int, ti.t.vector.elem_count * 4);
        }
    };
    return result;
}

get_basic_type_size :: fn(t: BasicType) -> int {
    if t.size != -1
        return t.size as int;
    return get_register_bit_count() / 8;
}

get_struct_size :: fn(st: type) -> int {
    t := type_info(st).t.struct_;
    if t.members.count == 0
        return 0;

    result := 0;
    biggest_member := 0;
    for m in t.members {
		member_size := get_type_size(m.t);
		if t.flags & .Packed == 0 {
			alignment := get_type_alignment(m.t);
			if alignment != 0
				result = misc.align_to(result, alignment);
		}
		result += member_size;
		if member_size > biggest_member
			biggest_member = member_size;
	}
	if t.flags & .Union != 0
		return biggest_member;
	if t.flags & .Packed == 0 {
		align := get_type_alignment(st);
		if align != 0
			result = misc.align_to(result, align);
	}
	return result;
}

get_type_size :: fn(t: type) -> int {
    ti := type_info(t);
    result := switch ti.kind {
        case .Basic: {
            yield get_basic_type_size(ti.t.basic);
        }
        case .Function: {
            yield get_register_bit_count();
        }
        case .Pointer: {
            yield get_register_bit_count();
        }
        case .Array: {
            yield get_type_size(ti.t.array.t) * ti.t.array.member_count as int;
        }
        case .Slice: {
            yield get_register_bit_count() / 4;
        }
        case .Enum: {
            yield get_type_size(ti.t.enum_.t);
        }
        case .Struct: {
            yield get_struct_size(t);
        }
        case .Vector: {
            yield cast(int, ti.t.vector.elem_count * 4);
        }
    };
    return result;
}

get_struct_member_offset :: fn(st: StructType, mem_idx: int) -> int {
    if st.members.count == 0 || mem_idx == 0 {
        return 0;
    }

	if st.flags & .Union != 0
		return 0;


    result := 0;
    for i := 0; i <= mem_idx; i += 1 {
        size := get_type_size(st.members[i].t);
		if st.flags & .Packed == 0 {
			align := get_type_alignment(st.members[i].t);
			if align != 0
				result = misc.align_to(result, align);
		}
        result += size;
    }
    result -= get_type_size(st.members[mem_idx].t);
    return result;
}

