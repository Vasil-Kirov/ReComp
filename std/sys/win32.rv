__WSAFDIsSet :: fn(
	unnamedParam1: SOCKET,
	unnamedParam2: *fd_set
) -> c_int #cc="stdcall" #foreign #link="__WSAFDIsSet";

FD_ZERO :: fn(set: *fd_set) #inline {
	set.fd_count = 0;
}

FD_SET :: fn(fd: SOCKET, set: *fd_set) #inline {
	__i: DWORD;
	for __i = 0; __i < set.fd_count; __i++ {
		if set.fd_array[__i] == fd {
			break;
		}
	}
	if __i == set.fd_count {
		if set.fd_count < FD_SETSIZE {
			set.fd_array[__i] = (fd);
			set.fd_count++;
		}
	}
}

FD_CLR :: fn(fd: SOCKET, set: *fd_set) #inline {
	for __i: DWORD = 0; __i < set.fd_count; __i++ {
		if set.fd_array[__i] == fd {
			for __i < set.fd_count-1 {
				set.fd_array[__i] = set.fd_array[__i+1];
				__i++;
			}
			set.fd_count--;
			break;
		}
	}
}
