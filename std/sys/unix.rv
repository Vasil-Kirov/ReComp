module unix;

#import "sys/linux_syscall.rv"

handle_stdin  :i32: 0;
handle_stdout :i32: 1;
handle_stderr :i32: 2;


#if x64 {
__SIZEOF_PTHREAD_MUTEX_T :: 40;
__SIZEOF_PTHREAD_ATTR_T :: 56;
__SIZEOF_PTHREAD_RWLOCK_T :: 56;
__SIZEOF_PTHREAD_BARRIER_T :: 32;
}
#elif x86 {
__SIZEOF_PTHREAD_MUTEX_T :: 32;
__SIZEOF_PTHREAD_ATTR_T :: 32;
__SIZEOF_PTHREAD_RWLOCK_T :: 44;
__SIZEOF_PTHREAD_BARRIER_T :: 20;
}
#else {
__SIZEOF_PTHREAD_MUTEX_T :: 24;
__SIZEOF_PTHREAD_ATTR_T :: 36;
__SIZEOF_PTHREAD_RWLOCK_T :: 32;
__SIZEOF_PTHREAD_BARRIER_T :: 20;
}
__SIZEOF_PTHREAD_MUTEXATTR_T :: 4;
__SIZEOF_PTHREAD_COND_T :: 48;
__SIZEOF_PTHREAD_CONDATTR_T :: 4;
__SIZEOF_PTHREAD_RWLOCKATTR_T :: 8;
__SIZEOF_PTHREAD_BARRIERATTR_T :: 4;


__old_kernel_stat :: struct {
	st_dev  : u16,
	st_ino  : u16,
	st_mode : u16,
	st_nlink: u16,
	st_uid  : u16,
	st_gid  : u16,
	st_rdev : u16,
	st_size : u64,
	st_atime: u64,
	st_mtime: u64,
	st_ctime: u64,
}

time_t :: int;
timespec :: struct {
	tv_sec:  time_t,       //* seconds */
	tv_nsec:    int,       //* nanoseconds */
};

syscall :: fn (number: int, args: ...) -> int #foreign;

PROT_READ  :i32: 0x1;
PROT_WRITE :i32: 0x2;
PROT_EXEC  :i32: 0x4;
PROT_NONE  :i32: 0x0;

MAP_SHARED		:i32: 0x00001;
MAP_PRIVATE		:i32: 0x00002;
MAP_ANONYMOUS	:i32: 0x00020;
MAP_ANON		:i32: 0x00020;
MAP_NORESERVE	:i32: 0x04000;
MAP_STACK       :i32: 0x20000;

O_RDONLY 	:u32: 0x0;
O_WRONLY 	:u32: 0x1;
O_RDWR 		:u32: 0x2;
O_CREAT		:u32: 0x40;
O_EXCL		:u32: 0x80;
O_NOCTTY	:u32: 0x100;
O_TRUNC		:u32: 0x200;
O_APPEND 	:u32: 0x400;
O_NONBLOCK	:u32: 0x800;


#if LIBC {
	exit :: fn (code: int) #foreign #no_return;
}
#else {
	exit :: fn (code: int) #no_return {
		syscall(SYS_exit_group, 1);
	}
}

DType :: enum: u8
{
	UNKNOWN = 0,
	FIFO = 1,
	CHR = 2,
	DIR = 4,
	BLK = 6,
	REG = 8,
	LNK = 10,
	SOCK = 12,
	WHT = 14
};

linux_dirent64 :: struct #pack {
	d_ino: u64,      /* Inode number */
	d_off: u64,      /* Not an offset; see below */
	d_reclen:  u16,  /* Length of this linux_dirent */
	d_type:    DType,/* File type */
	d_name: [0]u8,   /* Filename (null-terminated) */
}

off_t :: int;

/* Identifier for system-wide realtime clock.  */
CLOCK_REALTIME  :i32: 0;

/* Monotonic system-wide clock.  */
CLOCK_MONOTONIC :i32: 1;

/* High-resolution timer from the CPU.  */
CLOCK_PROCESS_CPUTIME_ID :i32: 2;

/* Thread-specific CPU-time clock.  */
CLOCK_THREAD_CPUTIME_ID :i32: 3;

/* Monotonic system-wide clock, not adjusted for frequency scaling.  */
CLOCK_MONOTONIC_RAW :i32: 4;

/* Identifier for system-wide realtime clock, updated only on ticks.  */
CLOCK_REALTIME_COARSE :i32: 5;

/* Monotonic system-wide clock, updated only on ticks.  */
CLOCK_MONOTONIC_COARSE :i32: 6;

/* Monotonic system-wide clock that includes time spent in suspension.  */
CLOCK_BOOTTIME :i32: 7;

/* Like CLOCK_REALTIME but also wakes suspended system.  */
CLOCK_REALTIME_ALARM :i32: 8;

/* Like CLOCK_BOOTTIME but also wakes suspended system.  */
CLOCK_BOOTTIME_ALARM :i32: 9;

/* Like CLOCK_REALTIME but in International Atomic Time.  */
CLOCK_TAI :i32: 11;

clock_gettime :: fn(clock_id: i32, tp: *timespec) -> int {
	return syscall(SYS_clock_gettime, clock_id, tp);
}

/**
* The copy_file_range() system call performs an in-kernel copy between two
* file descriptors without the additional cost of transferring data from the
* kernel to user space and then back into the kernel. It copies up to size
* bytes of data from the source file descriptor fd_in to the target file
* descriptor fd_out, overwriting any data that exists within the requested
* range of the target file.
*
* @param fd_in  fd of source file to copy from
* @param off_in pointer to an offset to start copying from, on completion the function
*               does not change the file pointer but adjusts the value pointed to here.
*               If null, the normal file pointer is used instead.
* @param fd_out fd of dest file to copy to
* @param off_out same as off_in, but for the destination file
* @param flags  must be 0, it exists for possible future extensions
*
*/
copy_file_range :: fn(fd_in: i32, off_in: ?*off_t, fd_out: i32, off_out: ?*off_t, size: uint, flags: u32 = 0) -> int {
	return syscall(SYS_copy_file_range, fd_in, off_in, fd_out, off_out, size, flags);
}

getpid :: fn() -> int {
	return syscall(SYS_getpid);
}

getppid :: fn() -> int {
	return syscall(SYS_getppid);
}

getdents64 :: fn(fd: i32, dirp: *void, count: uint) -> int {
	return syscall(SYS_getdents64, fd, dirp, count);
}

SIGSTKFLT	:c_int: 16;	/* Stack fault (obsolete).  */
SIGPWR		:c_int: 30;	/* Power failure imminent.  */

/* Historical signals specified by POSIX. */
SIGBUS		 :c_int: 7;	/* Bus error.  */
SIGSYS		:c_int: 31;	/* Bad system call.  */

/* New(er) POSIX signals (1003.1-2008, 1003.1-2013).  */
SIGURG		:c_int: 23;	/* Urgent data is available at a socket.  */
SIGSTOP		:c_int: 19;	/* Stop, unblockable.  */
SIGTSTP		:c_int: 20;	/* Keyboard stop.  */
SIGCONT		:c_int: 18;	/* Continue.  */
SIGCHLD		:c_int: 17;	/* Child terminated or stopped.  */
SIGTTIN		:c_int: 21;	/* Background read from control terminal.  */
SIGTTOU		:c_int: 22;	/* Background write to control terminal.  */
SIGPOLL		:c_int: 29;	/* Pollable event occurred (System V).  */
SIGXFSZ		:c_int: 25;	/* File size limit exceeded.  */
SIGXCPU		:c_int: 24;	/* CPU time limit exceeded.  */
SIGVTALRM	:c_int: 26;	/* Virtual timer expired.  */
SIGPROF		:c_int: 27;	/* Profiling timer expired.  */
SIGUSR1		:c_int: 10;	/* User-defined signal 1.  */
SIGUSR2		:c_int: 12;	/* User-defined signal 2.  */

/* ISO C99 signals.  */
SIGINT		:c_int: 2;	/* Interactive attention signal.  */
SIGILL		:c_int: 4;	/* Illegal instruction.  */
SIGABRT		:c_int: 6;	/* Abnormal termination.  */
SIGFPE		:c_int: 8;	/* Erroneous arithmetic operation.  */
SIGSEGV		:c_int: 11;	/* Invalid access to storage.  */
SIGTERM		:c_int: 15;	/* Termination request.  */

/* Historical signals specified by POSIX. */
SIGHUP		:c_int: 1;	/* Hangup.  */
SIGQUIT		:c_int: 3;	/* Quit.  */
SIGTRAP		:c_int: 5;	/* Trace/breakpoint trap.  */
SIGKILL		:c_int: 9;	/* Killed.  */
SIGPIPE		:c_int: 13;	/* Broken pipe.  */
SIGALRM		:c_int: 14;	/* Alarm clock.  */
/* Nonstandard signals found in all modern POSIX systems
   (including both BSD and Linux).  */
SIGWINCH	:c_int: 28;	/* Window size change (4.3 BSD, Sun).  */

/* Archaic names for compatibility.  */
SIGIO		:c_int: SIGPOLL;	/* I/O now possible (4.2 BSD).  */
//SIGIOT		:c_int: SIGABRT;	/* IOT instruction, abort() on a PDP-11.  */
SIGCLD		:c_int: SIGCHLD;	/* Old System V name */

__SIGRTMIN	:c_int: 32;
__SIGRTMAX	:c_int: 64;


/* Cloning flags.  */
CSIGNAL       :u64: 0x000000ff; /* Signal mask to be sent at exit.  */
CLONE_VM      :u64: 0x00000100; /* Set if VM shared between processes.  */
CLONE_FS      :u64: 0x00000200; /* Set if fs info shared between processes.  */
CLONE_FILES   :u64: 0x00000400; /* Set if open files shared between processes.  */
CLONE_SIGHAND :u64: 0x00000800; /* Set if signal handlers shared.  */
CLONE_PIDFD   :u64: 0x00001000; /* Set if a pidfd should be placed in parent.  */
CLONE_PTRACE  :u64: 0x00002000; /* Set if tracing continues on the child.  */
CLONE_VFORK   :u64: 0x00004000; /* Set if the parent wants the child to
				     wake it up on mm_release.  */
CLONE_PARENT  :u64: 0x00008000; /* Set if we want to have the same
				     parent as the cloner.  */
CLONE_THREAD  :u64: 0x00010000; /* Set to add to same thread group.  */
CLONE_NEWNS   :u64: 0x00020000; /* Set to create new namespace.  */
CLONE_SYSVSEM :u64: 0x00040000; /* Set to shared SVID SEM_UNDO semantics.  */
CLONE_SETTLS  :u64: 0x00080000; /* Set TLS info.  */
CLONE_PARENT_SETTID :u64: 0x00100000; /* Store TID in userlevel buffer
					   before MM copy.  */
CLONE_CHILD_CLEARTID :u64: 0x00200000; /* Register exit futex and memory
					    location to clear.  */
CLONE_DETACHED :u64: 0x00400000; /* Create clone detached.  */
CLONE_UNTRACED :u64: 0x00800000; /* Set if the tracing process can't
				      force CLONE_PTRACE on this clone.  */
CLONE_CHILD_SETTID :u64: 0x01000000; /* Store TID in userlevel buffer in
					  the child.  */
CLONE_NEWCGROUP    :u64: 0x02000000;	/* New cgroup namespace.  */
CLONE_NEWUTS :u64: 0x04000000;	/* New utsname group.  */
CLONE_NEWIPC :u64: 0x08000000;	/* New ipcs.  */
CLONE_NEWUSER :u64: 0x10000000;	/* New user namespace.  */
CLONE_NEWPID :u64: 0x20000000;	/* New pid namespace.  */
CLONE_NEWNET :u64: 0x40000000;	/* New network namespace.  */
CLONE_IO :u64: 0x80000000;	/* Clone I/O context.  */

/* cloning flags intersect with CSIGNAL so can be used only with unshare and
   clone3 syscalls.  */
CLONE_NEWTIME	:u64: 0x00000080;      /* New time namespace */


clone_args :: struct {
	flags: u64,        /* Flags bit mask */
	pidfd: u64,        /* Where to store PID file descriptor (int *) */
	child_tid: u64,    /* Where to store child TID, in child's memory (pid_t *) */
	parent_tid: u64,   /* Where to store child TID, in parent's memory (pid_t *) */
	exit_signal: u64,  /* Signal to deliver to parent on child termination */
	stack: u64,        /* Pointer to lowest byte of stack */
	stack_size: u64,   /* Size of stack */
	tls: u64,          /* Location of new TLS */
	set_tid: u64,      /* Pointer to a pid_t array (since Linux 5.5) */
	set_tid_size: u64, /* Number of elements in set_tid (since Linux 5.5) */
	cgroup: u64,       /* File descriptor for target cgroup
                                  of child (since Linux 5.7) */
}

pthread_t :: u64;

pthread_attr_t :: union {
	__size: [__SIZEOF_PTHREAD_ATTR_T]u8,
  __align: u64,
};

/* Create a new thread, starting with execution of START-ROUTINE
   getting passed ARG.  Creation attributed come from ATTR.  The new
   handle is stored in *NEWTHREAD.  */
pthread_create :: fn(thread: *pthread_t,
                          attr: ?*pthread_attr_t,
                          start_routine: fn(*void) -> ?*void,
                          arg: ?*) -> i32 #foreign;

/* Terminate calling thread.*/
pthread_exit :: fn (__retval: *void) #no_return #foreign;

/* Make calling thread wait for termination of the thread TH.  The
   exit status of the thread is stored in *THREAD_RETURN, if THREAD_RETURN
   is not NULL.*/
pthread_join :: fn (__th: pthread_t, __thread_return: **void) -> i32 #foreign;

/* Send signal SIGNO to the given thread. */
pthread_kill :: fn(__threadid: pthread_t, __signo: i32) -> i32 #foreign;

/* Cancel THREAD immediately or at the next possibility.  */
pthread_cancel :: fn(__th: pthread_t) -> i32 #foreign;

pthread_mutex_t :: union {
	__size: [__SIZEOF_PTHREAD_MUTEX_T]u8,
	__align: u64,
}

pthread_mutexattr_t :: union {
	__size: [__SIZEOF_PTHREAD_MUTEXATTR_T]u8,
	__align: c_int,
}

pthread_mutex_init :: fn(mutex: *pthread_mutex_t, mutexattr: *pthread_mutexattr_t) -> c_int #foreign;
pthread_mutex_lock :: fn(mutex: *pthread_mutex_t) -> c_int #foreign;
pthread_mutex_trylock :: fn(mutex: *pthread_mutex_t) -> c_int #foreign;
pthread_mutex_unlock  :: fn(mutex: *pthread_mutex_t) -> c_int #foreign;
pthread_mutex_destroy :: fn(mutex: *pthread_mutex_t) -> c_int #foreign;

kill :: fn(pid: i32, sig: c_int) -> int {
	return syscall(SYS_kill, pid, sig);
}

nanosleep :: fn(duration: *timespec, rem: ?*timespec) -> int {
	return syscall(SYS_nanosleep, duration, rem);
}

rmdir :: fn(path: *u8) -> int {
	return syscall(SYS_rmdir, path);
}

unlink :: fn(path: *u8) -> int {
	return syscall(SYS_unlink, path);
}

mkdir :: fn(path: *u8, mode: u32) -> int {
	return syscall(SYS_mkdir, path, mode);
}

mmap :: fn(size: int, prot: i32, flags: i32, mapat := null, fd: i32 = -1, off: uint = 0) -> ?* {
	ptr := syscall(SYS_mmap, mapat, size, prot, flags, fd, off) as *void;
	FAILED :: -1;
	if ptr == null || ptr == cast(*void, FAILED) {
		return null;
	}
	return ptr;
}

AT_FDCWD              :i32: -100;
AT_SYMLINK_NOFOLLOW   :i32: 0x100;
AT_EMPTY_PATH         :i32: 0x1000;

STATX_TYPE        :u32: 0x001;
STATX_MODE        :u32: 0x002;
STATX_NLINK       :u32: 0x004;
STATX_UID         :u32: 0x008;
STATX_GID         :u32: 0x010;
STATX_ATIME       :u32: 0x020 ;
STATX_MTIME       :u32: 0x040 ;
STATX_CTIME       :u32: 0x080 ;
STATX_INO         :u32: 0x100 ;
STATX_SIZE        :u32: 0x200 ;
STATX_BLOCKS      :u32: 0x400 ;
STATX_BASIC_STATS :u32: 0x7ff ;
STATX_BTIME       :u32: 0x800 ;

STATX_MNT_ID         :u32: 0x1000;
STATX_DIOALIGN       :u32: 0x2000;
STATX_MNT_ID_UNIQUE  :u32: 0x4000;
STATX_SUBVOL         :u32: 0x8000;
STATX_WRITE_ATOMIC   :u32: 0x10000;
STATX_DIO_READ_ALIGN :u32: 0x20000;

statx_timestamp :: struct {
	tv_sec:     i64,
	tv_nsec:    u32,
	__reserved: i32,
}

statx :: struct {                    // size 256
	stx_mask:                      u32,   // 0x00
	stx_blksize:                   u32,   // 0x04
	stx_attributes:                u64,   // 0x08
	stx_nlink:                     u32,   // 0x10
	stx_uid:                       u32,   // 0x14
	stx_gid:                       u32,   // 0x18
	stx_mode:                      u16,   // 0x1c
	_spare0:                       u16,   // 0x1e
	stx_ino:                       u64,   // 0x20
	stx_size:                      u64,   // 0x28
	stx_blocks:                    u64,   // 0x30
	stx_attributes_mask:           u64,   // 0x38
	stx_atime:                     statx_timestamp, // 0x40
	stx_btime:                     statx_timestamp, // 0x50
	stx_ctime:                     statx_timestamp, // 0x60
	stx_mtime:                     statx_timestamp, // 0x70
	stx_rdev_major:                u32,   // 0x80
	stx_rdev_minor:                u32,   // 0x84
	stx_dev_major:                 u32,   // 0x88
	stx_dev_minor:                 u32,   // 0x8c
	stx_mnt_id:                    u64,   // 0x90
	stx_dio_mem_align:             u32,   // 0x98
	stx_dio_offset_align:          u32,   // 0x9c
	stx_subvol:                    u64,   // 0xa0
	stx_atomic_write_unit_min:     u32,   // 0xa8
	stx_atomic_write_unit_max:     u32,   // 0xac
	stx_atomic_write_segments_max: u32,   // 0xb0
	stx_dio_read_offset_align:     u32,   // 0xb4
	stx_atomic_write_unit_max_opt: u32,   // 0xb8
	_spare2:                       u32,   // 0xbc
	_spare3:                       [8]u64, // 0xc0, ends at 0x100
}

/**
* Get information about file
*
* @param dirfd  fd to stat, or fd of dir if path is not null relative path
* @param path   path of file to stat, or null if dirfd is fd of the file
* @param flags  AT_ flags
* @param mask   STATX_ which fields in ptr to fill out
* @param ptr    receives info if function succeeds
*
*/
statx :: fn(dirfd: i32, path: ?*u8, flags: i32, mask: u32, ptr: *statx) -> int {
	path := path or c"";
	return syscall(SYS_statx, dirfd, path, flags, mask, ptr);
}

open :: fn(name: string, flags: u32, mode: u32 = 0) -> i32 {
	fd := syscall(SYS_open, name.data, flags, mode);
	return fd as i32;
}

write :: fn(fd: i32, buf: []u8) -> int {
	buf := buf;
	written := syscall(SYS_write, fd, &buf[0], buf.count);
	if written == -1 return 0;
	return written;
}

close :: fn(fd: i32) {
	syscall(SYS_close, fd);
}

munmap :: fn(ptr: *, size: uint) {
	syscall(SYS_munmap, ptr, size);
}

read :: fn(fd: i32, buf: []u8) -> int {
	return syscall(SYS_read, fd, buf.data, buf.count);
}


