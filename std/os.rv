module os

ListFileData :: struct
{
	dir: string,
	file: string,
	is_directory: bool,
}

AllocationFlags :: enum
{
	None = 0,
	Reserve = 0b01,
	Commit  = 0b10,
}

AllocationPerms :: enum
{
	None  = 0b000,
	Read  = 0b001,
	Write = 0b010,
	Exec  = 0b100,
}

FileOpenFlags :: enum
{
	None  = 0,
	Read  = 0b0001,
	Write = 0b0010,
	Create= 0b0100,
	Overwrite= 0b1000,
}

#if Windows
{
 	#import "os_win.rv"
}
#if VOS
{
	#import "os_vos.rv"
}
#if Unix
{
	#import "os_unix.rv"
}

