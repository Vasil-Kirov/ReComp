module parser;

_ :: #import mem;
_ :: #import "lexer.rv";
_ :: #import ast;
base :: #import base;
#import array;
#import os;

parse_tokens :: fn(tokens: []Token, allocator: *Allocator) -> ([]*Node, []string) {
	if tokens.count == 0
		return .{}, .{};

	parser := Parser {
		tokens = tokens,
		at = 0,
		current_token = &tokens[0],
		alloc = node_allocator,
		errors = array.create(string, node_allocator),
		current_builder = &builder,
	};

    result := array.create(*Node, parser.alloc);

	for {
		node, got_something := parse_top_level(&parser);
		if got_something {
			array.add(&global_body, node);
		}
	}

	return result, parser.errors;
}

parse_top_level :: fn(parser: *Parser) -> (Instruction, bool) {
	switch current(parser).type {
		case .ID: {
		}
	};
}

parse_unary :: fn(parser: *Parser) -> ?*Node {
}

parse_expression :: fn(parser: *Parser, current_prec := -999) -> ?*Node {
	lhs := parse_unary(parser);
	for {
		leftp, rightp := get_precedence(current(parser).type);
		if leftp < current_prec
			break;

		op := advance(parser);
		rhs := parse_expression(parser, rightp);
		lhs = make_binary(location(op), lhs, rhs, op.type as i16, parser.alloc);
	}
}

get_precedence :: fn(op: TokenType) -> (int, int) {
	return switch op
	{
		case .Dot:
			yield 90, 91;

		case .Pointer /* multiplication */, .Div, .Module:
			yield 80, 81;

		case .Plus, .Minus:
			yield 70, 71;

		case .ShiftLeft, .ShiftRight:
			yield 60, 61;

		case .And:
			yield 50, 51;

		case .Xor:
			yield 40, 41;

		case .Or:
			yield 30, 31;


		case .Lesser, .LesserEqual, .Greater, .GreaterEqual:
			yield 20, 21;

		case .EqualEqual, .NotEqual:
			yield 10, 11;

		case .LogicalAnd:
			yield 0, 1;

		case .LogicalOr:
			yield -10, -9;

		case .Equal, .PlusEqual, .MinusEqual, .TimesEqual, .DivideEqual, .ModEqual, .AndEqual, .XorEqual, .OrEqual, .ShiftLeftEqual, .ShiftRightEqual:
			yield -20, -21; // right to left precedence


		// Non binary operator, abort the loop
		case _:
			yield -1000, -1000;
	};
}

#private

Parser :: struct {
	tokens: []Token,
	at: int,
	alloc: *Allocator,
	errors: []string,
}

current :: fn(p: *Parser) -> *Token {
	return &p.tokens[p.at];
}

advance :: fn(p: *Parser) -> *Token {
	t := &p.tokens[p.at];
	p.at += 1;
	return t;
}

location :: fn(t: *Token) -> FileLocation {
	return t.range.start;
}

