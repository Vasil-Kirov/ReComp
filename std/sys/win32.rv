/* ==========================================================================
   SOCKETS (WINSOCK 2)
   ========================================================================== */

u_short: type: u16;

u_long: type: u32;

SOCKET: type: UINT_PTR;

ADDRESS_FAMILY: type: USHORT;

INVALID_SOCKET :: ( ( ~ 0 )as SOCKET );
SOCKET_ERROR :: ( - 1 );

AF_UNSPEC :: 0;
AF_INET :: 2;
AF_INET6 :: 23;
SOCK_STREAM :: 1;
SOCK_DGRAM :: 2;
IPPROTO_TCP :: 6;
IPPROTO_UDP :: 17;
IPPROTO_IPV6 :: 41;
SOMAXCONN :: 0x7fffffff;

SOL_SOCKET :: 0xffff;
SO_REUSEADDR :: 0x0004;
SO_KEEPALIVE :: 0x0008;
SO_SNDBUF :: 0x1001;
SO_RCVBUF :: 0x1002;
SO_RCVTIMEO :: 0x1006;
SO_SNDTIMEO :: 0x1005;
TCP_NODELAY :: 0x0001;
IPV6_V6ONLY :: 27;

MSG_PEEK :: 0x2;
MSG_WAITALL :: 0x8;

SD_RECEIVE :: 0;
SD_SEND :: 1;
SD_BOTH :: 2;

AI_PASSIVE :: 0x00000001;
FIONBIO :: ( (0x8004667E )as i32 );

WSAEWOULDBLOCK :: 10035;
WSAEMSGSIZE :: 10040;
WSAECONNRESET :: 10054;
WSAETIMEDOUT :: 10060;
WSAECONNREFUSED :: 10061;

FD_SETSIZE :DWORD: 64;

WSADATA :: struct {
	wVersion: WORD,
	wHighVersion: WORD,
	iMaxSockets: WORD,
	iMaxUdpDg: WORD,
	lpVendorInfo: ?*u8,
	szDescription: [257]i8,
	szSystemStatus: [129]i8,
}

LPWSADATA: type: ?*WSADATA;

sockaddr :: struct {
	sa_family: ADDRESS_FAMILY,
	sa_data: [14]i8,
}

in_addr :: struct {
	S_un: union {
		S_un_b: struct {
			s_b1: BYTE,
			s_b2: BYTE,
			s_b3: BYTE,
			s_b4: BYTE,
		},
		S_un_w: struct {
			s_w1: WORD,
			s_w2: WORD,
		},
		S_addr: DWORD,
	},
}

IN_ADDR: type: in_addr;

in6_addr :: struct {
	u: union {
		Byte: [16]UCHAR,
		Word: [8]USHORT,
	},
}

IN6_ADDR: type: in6_addr;

SCOPE_ID :: struct {
	u: union {
		s: struct {
			zone_level_bitfield: ULONG,
		},
		value: ULONG,
	},
}

sockaddr_in :: struct {
	sin_family: ADDRESS_FAMILY,
	sin_port: USHORT,
	sin_addr: IN_ADDR,
	sin_zero: [8]CHAR,
}

sockaddr_in6 :: struct {
	sin6_family: ADDRESS_FAMILY,
	sin6_port: USHORT,
	sin6_flowinfo: ULONG,
	sin6_addr: IN6_ADDR,
	u: union {
		sin6_scope_id: ULONG,
		sin6_scope_struct: SCOPE_ID,
	},
}

addrinfo :: struct {
	ai_flags: i32,
	ai_family: i32,
	ai_socktype: i32,
	ai_protocol: i32,
	ai_addrlen: uint,
	ai_canonname: ?*u8,
	ai_addr: ?*sockaddr,
	ai_next: ?*addrinfo,
}

fd_set :: struct {
	fd_count: DWORD,
	fd_array: [64]SOCKET,
}

timeval :: struct {
	tv_sec: i32,
	tv_usec: i32,
}

WSAStartup :: fn(
	wVersionRequired: WORD,
	lpWSAData: LPWSADATA
) -> i32 #cc="stdcall" #foreign #link="WSAStartup";

