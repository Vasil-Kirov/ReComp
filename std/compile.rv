module compile

#import str;
#import io;
#import os;
#import mem;
#import array;
#import ast;

static_assert :: fn(location: FileLocation, cond: bool, fmt: string, args: ...) {
	if cond
		return;

	s := io.vsprint(fmt, args);
	s = io.sprint("Static assertion failed. %", s);
	raise_error_(&s, location);
}

raise_error :: fn(location: FileLocation, fmt: string, args: ...) {
	s := io.vsprint(fmt, args);
	raise_error_(&s, location);
}

no_compile_output :: fn() #intrinsic;
get_build_args :: fn() -> []string #intrinsic;

#private
bit: fn(u32) -> u32 : n -> 1 << n;
#public

CompileFlag :: enum: u32 {
    Debug        = bit(0),
    SanAddress   = bit(1),
    SanMemory    = bit(2),
    SanThread    = bit(3),
    SanUndefined = bit(4),
	NoLibC	     = bit(5),
    SharedLib    = bit(6),
    CrossAndroid = bit(7),
    NoLink       = bit(8),
    Standalone   = bit(9),
    DebugInfo    = bit(10),
	DisableAssert= bit(11),
	DisableBoundsCheck=bit(12),
}

Arch :: enum: u32 {
    x86_64      = 0b00000,
    x86         = 0b00001,
    Arm32       = 0b00010,
    Arm64       = 0b00100,
	Wasm32		= 0b01000,
	Wasm64		= 0b10000,
}

CompileInfo :: struct {
	custom_files: []CustomFile,
    source_dirs: []string,
    files: []string,
	defines: []string,
    opt: int,
    flags: CompileFlag,
    target_triple: string,
    arch: Arch,
	link: string,
	internals_file: string,
	entry_point: string,
}

CustomFile :: struct {
	path: string,
	module_name: string,
	content: string,
	nodes: []*ast.Node,
	alloc: *mem.Allocator,
}

custom_file_make :: fn(path: string, module_name: string, alloc: *mem.Allocator) -> CustomFile {
	b := str.create_builder(alloc);
	str.builder_append(&b, "module ");
	str.builder_append(&b, module_name);
	str.builder_append(&b, ";\n");

	s := str.from_builder(&b, alloc);
	return .{
		path = path,
		module_name = module_name,
		alloc = alloc,
		content = s,
		nodes = array.create(*ast.Node, alloc),
	};
}

FnArg :: struct {
	name: string,
	t: string,
};

file_append_string :: fn(f: *CustomFile, s: string) {
	b := str.create_builder(f.alloc);
	str.builder_append(&b, f.content);
	str.builder_append(&b, s);
	f.content = str.from_builder(&b, f.alloc);
}

file_make_location :: fn(f: *CustomFile, line: int, char: int) -> FileLocation {
	return .{
		f.path,
		line,
		char,
	};
}

file_add_function :: fn(m: *CustomFile, line: int, char: int, fname: string, args: []FnArg, ret_types: []string, link := "") -> ?*ast.Node{
	link := link;
	if link == ""
		link = fname;

	location := file_make_location(m, line, char);

	arg_nodes := []*ast.Node{};
	ret_nodes := []*ast.Node{};
	ok1: bool = true;
	ok2: bool = true;
	if args.count > 0 {
		arg_nodes, ok1 = mem.make_slice(*ast.Node, args.count, m.alloc);
	}
	if ret_types.count > 0 {
		ret_nodes, ok2 = mem.make_slice(*ast.Node, ret_types.count, m.alloc);
	}
	if !ok1 || !ok2 {
		raise_error(location, "Failed to allocate memory for function signature while generating file, needed % args and % return typers.", args.count, ret_types.count);
		return null;
	}

	for i, arg in args {
		t := ast.make_id(arg.t, location, m.alloc);
		if !t {
			raise_error(location, "Failed to allocate memory for type node while generating function.");
			return null;
		}
		v := ast.make_var(arg.name, t, null, location, m.alloc);
		if !v {
			raise_error(location, "Failed to allocate memory for arg node while generating function.");
			return null;
		}
		arg_nodes[i] = v;
	}
	for i, ret in ret_types {
		n := ast.make_id(ret, location, m.alloc);
		if !n {
			raise_error(location, "Failed to allocate memory for return type while generating function.");
			return null;
		}
		ret_nodes[i] = n;
	}

	f := ast.make_fn(fname, link, arg_nodes, ret_nodes, .{}, .Function | .Public, location, m.alloc);
	if !f {
		raise_error(location, "Failed to allocate function node.");
		return null;
	}
	array.add(&m.nodes, f);
	return f;
}

file_make_const_data :: fn(m: *CustomFile, line: int, char: int, data_in: []u8) -> *ast.Node {
	data, ok := mem.dupe(data_in, m.alloc);
	#assert ok;

	location := file_make_location(m, line, char);

	ns := mem.make_type(ast.NodeString, m.alloc);
	#assert ns;
	ns.data = data.data;
	ns.size = data.count as uint;
	
	cv: ast.ConstValue = .{};
	cv.t = .String;
	cv.u.str.data = ns;

	n := ast.make_const(location, cv, m.alloc);
	#assert n;
	return n;
}

file_make_id :: fn(m: *CustomFile, id: string, line: int, char: int) -> *ast.Node {
	fl := file_make_location(m, line, char);

	idn := ast.make_id(id, fl, m.alloc); #assert idn;
	return idn;
}

file_add_constant :: fn(m: *CustomFile, name: string, t: *ast.Node, v: *ast.Node, line: int, char: int) -> *ast.Node {
	location := file_make_location(m, line, char);

	id := ast.make_id(name, location, m.alloc);
	#assert id;
	decl := ast.make_decl(name, id, v, t, .Const | .Public, location, m.alloc);
	#assert decl;
	array.add(&m.nodes, decl);
	return decl;
}

file_make_const_int :: fn(m: *CustomFile, n: i64, line: int, char: int) -> *ast.Node {
	fl := file_make_location(m, line, char);

	intt := file_make_t(m, int, line, char);
	cv: ast.ConstValue = .{};
	cv.t = .Integer;
	cv.u.int_.is_signed = true;
	cv.u.int_.u.signed = n;
	n := ast.make_const(fl, cv, m.alloc); #assert n;
	return n;
}

file_make_t :: fn(m: *CustomFile, t: type, line: int, char: int) -> *ast.Node {
	fl := file_make_location(m, line, char);

	ti := type_info(t);
	switch ti.kind {
		case .Basic:
		{
			using ti.t.basic;
			switch kind {
				case .Bool, .U8, .U16, .U32, .U64, .I8, .I16, .I32, .I64, .F32, .F64, .Int, .Uint, .String, .Type:
				{
					n := ast.make_id(name, fl, m.alloc); #assert n;
					return n;
				}
				case _: {}
			};
		}
		case .Array:
		{
			using ti.t.array;
			tn := file_make_t(m, t, line, char);
			sz := file_make_const_int(m, member_count as i64, line, char);
			st := ast.make_arraytype(fl, tn, sz, m.alloc); #assert st;
			return st;
		}
		case .Slice:
		{
			using ti.t.slice;
			tn := file_make_t(m, t, line, char);
			st := ast.make_arraytype(fl, tn, null, m.alloc); #assert st;
			return st;
		}
		case .Struct:
		{
			using ti.t.struct_;
			mems, ok := mem.make_slice(*ast.Node, members.count, m.alloc);
			for i, mem in members {
				memt := file_make_t(m, mem.t, line, char);
				n := ast.make_var(mem.name, memt, null, fl, m.alloc); #assert n;
				mems[i] = n;
			}
			b := str.create_builder(m.alloc);
			str.builder_append(&b, m.module_name);
			str.builder_append(&b, ".");
			dot := -1;
			for i, c in name {
				if c == '.' {
					dot = i;
					break;
				}
			}
			if dot == -1
				return ast.make_struct_decl(name, mems, .{}, flags as u32, fl, m.alloc);
			else {
				str.builder_append(&b, name[dot+1:]);
				return ast.make_struct_decl(str.from_builder(&b, m.alloc), mems, .{}, flags as u32, fl, m.alloc);
			}
		}
		case _:
		{
		}
	};
	raise_error(fl, "Unsupported type % passed to file_make_t()", t);
	n := ast.make_id("int", fl, m.alloc); #assert n;
	return n;
}

#private
raise_error_ :: fn(s: *string, location: FileLocation) #intrinsic;

