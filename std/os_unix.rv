	create_thread :: fn(start: fn(*void) -> ThreadRetType, arg: ?*void) -> (ThreadID, bool) #nocheck {
		thread: pthread_t;
		if pthread_create(&thread, null, start, arg) != 0
			return 0, false;
		return thread, true;

