module nostdlib

memcpy :: fn #foreign(dst: *, src: *, size: int) -> * {
	d: *u8 = dst;
	s: *u8 = src;
	for i in size {
		d[i] = s[i];
	}

	return dst;
}

memset :: fn #foreign(dst: *, val: i32, num: int) -> * {
	d: *u8 = dst;
	for i in num {
		d[i] = val as u8;
	}

	return dst;
}

memcmp :: fn #foreign(p1: *, p2: *, num: int) -> c_int {
	a := p1 as *u8;
	b := p2 as *u8;
	for i in num {
		res := a[i] - b[i];
		if res != 0
			return res as c_int;
	}
	return 0;
}

_fltused :: fn #foreign() {}

#if Windows {
    __chkstk :: fn #foreign() {}
}


